{
  "expo": {
    "name": "Live STT Overlay",
    "slug": "live-stt-overlay",
    "version": "0.1.0",
    "orientation": "landscape",
    "scheme": "livesttoverlay",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "requireFullScreen": true
    },
    "android": {
      "package": "com.livesttoverlay.app",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "react-native-vosk",
        {
          "models": ["models/vosk-model-small-ko-0.22"],
          "iOSMicrophonePermission": "음성을 텍스트로 변환하기 위해 마이크 권한이 필요합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
